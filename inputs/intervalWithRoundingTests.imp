class IntervalTests {
    // Teste les opérations de base avec des flottants
    basicOperations() {
        def i = 2.0;
        def j = -10.0;
        def a = i + j;
        def s = i - j;
        def m = i * j;
        j = j * 2.22222; // -22.2222
        j = j * 10.97579; // == -243.906200538
        j = j / 10.111; // 24.122856348333498
        def count = 0.0;
        count = count + 1.11;
        count = count + 1.11;
        count = count + 1.11;
        count = count + 1.11;
        count = count + 1.11;
        count = count/1.11;
    }

    // Teste une boucle while avec un paramètre
    whileLoop(a) {
        def x = 0.0;
        while (x < a)
            x = x+1.0;
    }

    // Teste plusieurs valeurs avec des conditions
    severalValues() {
        def i = 0.0;
        def j = 1.0;
        if (i > 1.0) {
            i = 1.0;
            j = 2.0;
        }
        if (i > 1.0) {
            i = i + 1.0;
            j = j + 2.0;
        }
        if (i > 1.0) {
            i = i + 1.0;
            j = j + 2.0;
        }
        def a = i + j;
    }

    // Teste une boucle while simple
    whileStatement() {
        def i = 0.0;
        while (i < 3)
            i = i + 1.1;
    }

    // Teste une condition if simple
    ifStatement() {
        def i = 0.0;
        if (i > 0.0)
            i = 1.0;
        def j = i * 0.0;
    }
}
