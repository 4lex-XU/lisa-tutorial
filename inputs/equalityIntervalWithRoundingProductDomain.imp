class IntervalEqualityTests {

    basicOperations() {
      def x = 0;
      def y = 0;
      def z = x;
      def w = z + 1.1;
      def vv = 1.1;
      if (vv == w) {
        def i = 2.2 / 2;
        w = y + i;
      }
    }

    ifStatement() {
      def x = 0;
      def y = 0;
      def z = x;
      def w = x + 1;
      if (x == 0){
        z = z * 1;
        w = x;
      }
    }

    whileStatement() {
      def x = 0;
      def y = 2.2;
      def z = 0;
      z = z + 1.1;
      z = z + 1.1;
      while (x < y) {
        x = x + 1.1;
      }
    }
}
