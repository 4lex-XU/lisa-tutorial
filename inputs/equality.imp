class equality {

    test1(x) {
        def y = x;
        def z = y;
        def w = 3;
        y = w;

        /* Résultat attendu :
           x: [x]
           y: [y, w]
           z: [z]
           w: [y, w]
        */
        /* Résultat obtenu :
           x: [x]
           y: [y, w]
           z: [z]
           w: [y, w]
        */
    }

    test2() {
        def a = 1;
        def b = 1;
        def c = a;
        if (a == b) {
            def d = a;
        }

        /* Résultat attendu :
            a: [a, b, c]
            b: [a, b, c]
            c: [a, b, c]
            d: [d]
        */
        /* Résultat obtenu :
            a: [a, b, c]
            b: [a, b, c]
            c: [a, b, c]
            d: [d]
        */
    }

    test3(x) {
        def y = x + 1;
        def z = y;
        x = 0;

        /* Résultat attendu :
           x: [x]
           y: [y, z]
           z: [y, z]
        */
        /* Résultat obtenu :
           x: [x]
           y: [y, z]
           z: [y, z]
        */
    }

    test5() {
        def x = 0;
        def y = 0;
        while (x < 10) {
            x = x + 1;
            y = y + 1;
        }

        /* Résultat attendu :
           x: [x, y]
           y: [x, y]
        */
        /* Résultat obtenu :
            x: [x, y]
            y: [x, y]
        */
    }
}
